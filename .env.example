# Production image used by docker-compose.prod.yml.
FRONTEND_IMAGE=ghcr.io/your-org/language-learning-frontend
FRONTEND_IMAGE_TAG=latest

# Public values are embedded into the browser bundle during `docker build`.
# Use an absolute backend URL for direct access now; this may become /api later.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudflare R2 custom asset hostname, without protocol or path.
NEXT_PUBLIC_ASSETS_HOSTNAME=assets.<OUR_DOMAIN>
